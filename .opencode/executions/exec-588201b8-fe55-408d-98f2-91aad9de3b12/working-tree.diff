+
+.confirm-dialog {
+  background: #112240;
+  border-radius: 10px;
+  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
+  padding: 28px 32px;
+  border: 1px solid rgba(255, 255, 255, 0.05);
+  min-width: 320px;
+  max-width: 420px;
+  width: 90%;
+  box-sizing: border-box;
