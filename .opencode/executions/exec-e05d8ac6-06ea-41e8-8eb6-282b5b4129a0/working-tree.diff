+/* Sidebar Layout */
+.App--sidebar {
+  display: flex;
+  text-align: left;
+  min-height: 100vh;
+}
+
+/* Sidebar Component */
+.sidebar {
+  width: 220px;
+  min-width: 220px;
+  background: #112240;
+  display: flex;
+  flex-direction: column;
+  transition: width 0.3s ease, min-width 0.3s ease;
+  position: relative;
+  border-right: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.sidebar--collapsed {
+  width: 60px;
+  min-width: 60px;
+}
+
+.sidebar-toggle {
+  background: none;
+  border: none;
+  color: #a8b2d1;
+  font-size: 20px;
+  padding: 16px;
+  cursor: pointer;
+  text-align: center;
+  transition: color 0.2s ease;
+}
+
+.sidebar-toggle:hover {
+  color: #ffffff;
+}
+
+.sidebar-nav {
+  display: flex;
+  flex-direction: column;
+  padding: 8px 0;
+}
+
+.sidebar-nav-item {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  background: none;
+  border: none;
+  color: #a8b2d1;
+  font-size: 15px;
+  padding: 12px 20px;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  text-align: left;
+  width: 100%;
+  border-left: 3px solid transparent;
+}
+
+.sidebar-nav-item:hover {
+  color: #e6f1ff;
+  background: rgba(255, 255, 255, 0.05);
+}
+
+.sidebar-nav-item--active {
+  color: #e6f1ff;
+  background: rgba(29, 99, 184, 0.15);
+  border-left-color: #1d63b8;
+}
+
+.sidebar--collapsed .sidebar-nav-item {
+  justify-content: center;
+  padding: 12px 0;
+  border-left-width: 0;
+}
+
+.sidebar-nav-label {
+  white-space: nowrap;
+  overflow: hidden;
+}
+
+.sidebar-nav-item i {
+  font-size: 18px;
+  width: 20px;
+  text-align: center;
+}
+
+/* Dashboard Content */
+.dashboard-content {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  position: relative;
+  min-height: 100vh;
+}
+
+/* Orders Page */
+.orders-container {
+  flex: 1;
+  padding: 40px;
+  max-width: 1100px;
+  width: 100%;
+  box-sizing: border-box;
+}
+
+.orders-title {
+  color: #ffffff;
+  font-size: 28px;
+  margin: 0 0 24px 0;
+  font-weight: 700;
+}
+
+.orders-search {
+  margin-bottom: 24px;
+}
+
+.orders-table-wrapper {
+  overflow-x: auto;
+  border-radius: 8px;
+  border: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.orders-table {
+  width: 100%;
+  border-collapse: collapse;
+  background: #112240;
+  min-width: 600px;
+}
+
+.orders-table-th {
+  color: #8892b0;
+  font-size: 13px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  text-align: left;
+  padding: 16px 20px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+  background: #0a192f;
+}
+
+.orders-table-td {
+  color: #e6f1ff;
+  font-size: 14px;
+  padding: 14px 20px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.orders-table tbody tr:hover {
+  background: rgba(29, 99, 184, 0.08);
+}
+
+.orders-table tbody tr:last-child td {
+  border-bottom: none;
+}
+
+.orders-no-results {
+  color: #8892b0;
+  text-align: center;
+  padding: 40px 20px;
+  font-size: 15px;
+}
+
