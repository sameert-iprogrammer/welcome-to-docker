{
  "schemaVersion": 1,
  "project": {
    "name": "welcome-to-docker",
    "type": "React SPA",
    "stackSummary": "React 18, Create React App, plain CSS, Font Awesome CDN, localStorage auth"
  },
  "agentEntryPoints": {
    "sdlcRules": ".opencode/agents/_sdlc-rules.md",
    "governance": ".opencode/agents/governance-agent.md",
    "projectContext": "docs/ai/project-context.md",
    "contextMap": "docs/ai/context-map.json"
  },
  "routing": {
    "strategy": "react-router",
    "knownPaths": ["/login", "/register", "/dashboard", "/settings", "/orders", "/customers"]
  },
  "stateManagement": "localState",
  "styling": "plainCSS",
  "testing": {
    "framework": "jest",
    "command": "npm test"
  },
  "buildCommand": "npm run build",
  "devCommand": "npm start",
  "commonPaths": {
    "source": "src/",
    "components": "src/",
    "styles": ["src/App.css", "src/index.css"],
    "config": ["package.json"],
    "deployment": ["Dockerfile"]
  },
  "keyFiles": {
    "entry": "src/index.js",
    "appRoot": "src/App.js",
    "dockerfile": "Dockerfile"
  },
  "agentNotes": "Minimal educational React SPA. No react-router, no backend, no TypeScript, no CSS frameworks. localStorage mock auth. pushState routing. Preserve existing patterns. Reference governance before changes."
}
